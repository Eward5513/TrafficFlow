{
  "model_name": "graph_wavenet",
  "framework": "pytorch",
  "code_version": "0.1.0",
  "data_root": "reimplementation/stgcn/prepared_data/r-only",
  "adjacency": "reimplementation/dcrnn/prepared_data/r-only/adjacency_matrix/dcrnn_weighted_adjacency.npy",
  "adjacency_pickle": "reimplementation/dcrnn/prepared_data/r-only/adjacency_matrix/dcrnn_adj_mx.pkl",
  "graph_metadata": "reimplementation/dcrnn/prepared_data/r-only/adjacency_matrix/dcrnn_graph_metadata.json",
  "graph_validation": "reimplementation/dcrnn/prepared_data/r-only/adjacency_matrix/dcrnn_graph_validation.json",
  "r_nodes": "analysis/graph/r_graph/r_nodes.csv",
  "node_mapping": "reimplementation/stgcn/prepared_data/r-only/node_mapping.csv",
  "normalization": "reimplementation/stgcn/prepared_data/r-only/normalization.json",
  "split_manifest": "reimplementation/stgcn/prepared_data/r-only/split_manifest.json",
  "dataset_metadata": "reimplementation/stgcn/prepared_data/r-only/dataset_metadata.json",
  "data_validation": "reimplementation/stgcn/prepared_data/r-only/validation_summary.json",
  "output_root": "reimplementation/graph_wavenet/experiments/r_only",
  "rates": ["p05", "p10", "p20", "p30", "p40", "p50", "p70"],
  "seq_len": 12,
  "seq_length": 12,
  "n_his": 12,
  "horizon": 1,
  "output_steps": 1,
  "target_mode": "last-observed-step",
  "num_nodes": 56,
  "input_channels": 1,
  "output_channels": 1,
  "nhid": 32,
  "residual_channels": 32,
  "dilation_channels": 32,
  "skip_channels": 256,
  "end_channels": 512,
  "blocks": 4,
  "layers": 2,
  "kernel_size": 2,
  "gcn_order": 2,
  "adjtype": "doubletransition",
  "gcn_bool": true,
  "addaptadj": true,
  "randomadj": true,
  "adaptive_embedding_dimension": 10,
  "engine_left_pad": 1,
  "receptive_field": 13,
  "epochs": 100,
  "batch_size": 64,
  "learning_rate": 0.001,
  "optimizer": "adam",
  "weight_decay": 0.0001,
  "dropout": 0.3,
  "max_grad_norm": 5.0,
  "learning_rate_schedule": null,
  "early_stopping_patience": 0,
  "seed": 42,
  "device": "auto",
  "num_workers": 0,
  "amp": false,
  "checkpoint_monitor": "validation_mae_raw_all",
  "clip_negative_predictions": false,
  "loss": "masked_mae_raw_null_val_0",
  "null_val": 0.0,
  "initialization": "PyTorch Conv2d defaults; nodevec1/nodevec2 ~ N(0,1) when randomadj",
  "adaptations": [
    {
      "field": "num_nodes",
      "original_value": 207,
      "adapted_value": 56,
      "adaptation_reason": "R-only subgraph has 56 SUMO edges."
    },
    {
      "field": "in_dim",
      "original_value": 2,
      "adapted_value": 1,
      "adaptation_reason": "Prepared NPZ stores a single observed-flow channel, not PeMS speed + time-of-day."
    },
    {
      "field": "out_dim / horizon / target_mode",
      "original_value": "out_dim=seq_length=12 future steps",
      "adapted_value": "out_dim=1, last-observed-step reconstruction, Y = full_flow[s+11]",
      "adaptation_reason": "Same-window full-flow reconstruction, not PeMS future forecasting."
    },
    {
      "field": "graph input",
      "original_value": "METR-LA adj_mx.pkl",
      "adapted_value": "read-only dcrnn_weighted_adjacency.npy / dcrnn_adj_mx.pkl",
      "adaptation_reason": "Directed metre-scale Gaussian W is already prepared; do not rerun PeMS construction or use STGCN symmetric W."
    },
    {
      "field": "checkpoint_monitor",
      "original_value": "mean masked MAE val_loss (zeros excluded)",
      "adapted_value": "validation MAE on raw counts including zeros",
      "adaptation_reason": "Project-wide checkpoint rule. Original masked loss is still the training objective."
    },
    {
      "field": "DataLoader padding last sample",
      "original_value": "pad_with_last_sample=True",
      "adapted_value": "drop_last=False and no last-sample padding",
      "adaptation_reason": "Project rule: keep the last incomplete batch without duplicating samples."
    },
    {
      "field": "gate/residual/skip conv class",
      "original_value": "nn.Conv1d with kernel_size=(1, k) on 4-D tensors",
      "adapted_value": "nn.Conv2d with the same (1, k) kernels",
      "adaptation_reason": "Original tuple kernel on Conv1d is a 4-D Conv2d layout and is not runnable on current PyTorch."
    }
  ]
}
