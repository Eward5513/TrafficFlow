    },
    {
      "field": "lr_decay_step_unit",
      "original_value": "tf.train.exponential_decay staircase, decay_steps=5*epoch_step, global_steps += 1 each training batch",
      "adapted_value": "torch.optim.lr_scheduler.StepLR(step_size=5*batches_per_epoch, gamma=0.7) stepped after every training batch",
      "adaptation_reason": "Keep the original 0.7 drop every 5 epochs measured in optimizer steps. Do not step the scheduler once per epoch."
    },
    {
      "field": "framework",
      "original_value": "TensorFlow 1.x",
      "adapted_value": "PyTorch",
      "adaptation_reason": "Project-wide reimplementation standard."
