{
  "model_name": "pdformer",
  "framework": "pytorch",
  "code_version": "0.1.0",
  "original_repo": "https://github.com/aptx1231/PDFormer",
  "original_paper": "AAAI 2023 PDFormer: Propagation Delay-aware Dynamic Long-range Transformer for Traffic Flow Prediction",
  "original_framework": "LibCity / PyTorch",
  "original_official_config": "PeMS04.json overlaying libcity/config/model/traffic_state_pred/PDFormer.json",
  "original_command": "python run_model.py --task traffic_state_pred --model PDFormer --dataset PeMS04 --config_file PeMS04",
  "license": "MIT Copyright 2022 aptx1231",
  "data_root": "reimplementation/stgcn/prepared_data/r-only",
  "undirected_topology": "reimplementation/stgcn/prepared_data/r-only/adjacency_matrix/stgcn_undirected_topology.npy",
  "directed_adjacency": "analysis/graph/r_graph/r_adjacency.npy",
  "weighted_adjacency_not_for_hop": "reimplementation/stgcn/prepared_data/r-only/adjacency_matrix/stgcn_weighted_adjacency.npy",
  "relations_dir": null,
  "r_nodes": "analysis/graph/r_graph/r_nodes.csv",
  "node_mapping": "reimplementation/stgcn/prepared_data/r-only/node_mapping.csv",
  "normalization": "reimplementation/stgcn/prepared_data/r-only/normalization.json",
  "split_manifest": "reimplementation/stgcn/prepared_data/r-only/split_manifest.json",
  "dataset_metadata": "reimplementation/stgcn/prepared_data/r-only/dataset_metadata.json",
  "data_validation": "reimplementation/stgcn/prepared_data/r-only/validation_summary.json",
  "weekday_mapping": null,
  "output_root": "reimplementation/pdformer/experiments/r_only",
  "rates": ["p05", "p10", "p20", "p30", "p40", "p50", "p70"],
  "n_his": 12,
  "input_window": 12,
  "output_window": 1,
  "horizon": 1,
  "output_dim": 1,
  "target_mode": "last-observed-step",
  "num_nodes": 56,
  "embed_dim": 64,
  "skip_dim": 256,
  "lape_dim": 8,
  "geo_num_heads": 4,
  "sem_num_heads": 2,
  "t_num_heads": 2,
  "temporal_num_heads": 2,
  "num_heads": 8,
  "mlp_ratio": 4,
  "qkv_bias": true,
  "drop": 0,
  "attn_drop": 0,
  "drop_path": 0.3,
  "s_attn_size": 3,
  "t_attn_size": 1,
  "enc_depth": 6,
  "type_ln": "pre",
  "type_short_path": "hop",
  "bidir": true,
  "far_mask_delta": 7,
  "dtw_delta": 5,
  "n_cluster": 16,
  "pattern_key_count": 16,
  "cluster_max_iter": 5,
  "cluster_method": "kshape",
  "cand_key_days": 14,
  "add_time_in_day": true,
  "add_day_in_week": false,
  "random_flip": true,
  "set_loss": "huber",
  "huber_delta": 2,
  "batch_size": 16,
  "optimizer": "adamw",
  "learner": "adamw",
  "learning_rate": 0.001,
  "weight_decay": 0.05,
  "lr_decay": true,
  "lr_scheduler": "cosinelr",
  "lr_eta_min": 0.0001,
  "lr_warmup_epoch": 5,
  "lr_warmup_init": 1e-6,
  "clip_grad_norm": true,
  "max_grad_norm": 5,
  "epochs": 200,
  "max_epoch": 200,
  "patience": 50,
  "use_curriculum_learning": true,
  "seed": 42,
  "device": "cpu",
  "num_workers": 0,
  "checkpoint_monitor": "validation_mae_raw_all",
  "clip_negative_predictions": false,
  "adaptations": [
    {
      "field": "num_nodes",
      "original_value": "PeMS04 307 / PeMS08 170",
      "adapted_value": 56,
      "adaptation_reason": "R-only subgraph has 56 SUMO edges."
    },
    {
      "field": "output_window",
      "original_value": 12,
      "adapted_value": 1,
      "adaptation_reason": "Last-observed-step reconstruction. end_conv1 out_channels is 1, not a slice of a 12-step head."
    },
    {
      "field": "add_day_in_week",
      "original_value": true,
      "adapted_value": false,
      "adaptation_reason": "Simulation days are labeled day_NN with begin=0/end=86400 and no calendar dates. weekday embedding code is kept; enabling it requires an explicit weekday_mapping JSON. day_index % 7 is forbidden."
    },
    {
      "field": "seed",
      "original_value": "PeMS04.json seed=1",
      "adapted_value": 42,
      "adaptation_reason": "Repository default seed."
    },
    {
      "field": "DTW input",
      "original_value": "mean daily curve over concatenated dyna files including eval/test",
      "adapted_value": "training_days full-flow only, shared across penetrations",
      "adaptation_reason": "Prevent validation/test leakage."
    },
    {
      "field": "loss zeros",
      "original_value": "unmasked Huber after inverse transform; masked_mae is the generic default not used by PeMS04",
      "adapted_value": "Huber delta=2 on denormalized pred vs y_raw; zeros kept",
      "adaptation_reason": "Prepared full flow zeros are valid counts, not PeMS missing values."
    },
    {
      "field": "hop graph",
      "original_value": "binarize LibCity adj_mx then Floyd–Warshall cap 511",
      "adapted_value": "stgcn_undirected_topology.npy 0/1, bidir=true",
      "adaptation_reason": "Do not treat STGCN Gaussian weights as hop distances."
    }
  ]
}
